<?xml version="1.0" encoding="UTF-8"?>

<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" >
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:key="@string/pref_category_group_sound_key">
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.SoundFeedbackFragment"
        android:key="@string/pref_sound_feedback_screen_key"
        android:title="@string/title_pref_sound_feedback" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.SoundOutputFragment"
        android:key="@string/pref_sound_output_screen_key"
        android:title="@string/title_pref_sound_output" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.SoundDuckingFragment"
        android:key="@string/pref_sound_ducking_screen_key"
        android:title="@string/title_pref_sound_ducking" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.soundthemes.SoundThemesFragment"
        android:key="pref_sound_themes"
        android:title="@string/title_pref_sound_themes"
        android:summary="@string/summary_pref_sound_themes" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.individualfeedback.IndividualFeedbackFragment"
        android:key="pref_individual_feedback"
        android:title="@string/title_pref_individual_feedback"
        android:summary="@string/summary_pref_individual_feedback" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.SoundVibrationFragment"
        android:key="@string/pref_sound_vibration_screen_key"
        android:title="@string/title_pref_sound_vibration" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.SoundFeatureSoundsFragment"
        android:key="@string/pref_sound_feature_sounds_screen_key"
        android:title="@string/title_pref_sound_feature_sounds" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.talkback.preference.base.AccessibilityFooterPreference
      android:key="@string/pref_speech_footer_key"
      android:title="@string/title_pref_speech_footer"
      android:selectable="false" />
</PreferenceScreen>
