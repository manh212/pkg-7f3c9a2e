  <string name="voice_commands_help_title">Tổng quan về lệnh thoại</string>
  <string name="voice_commands_help_description">Để dùng lệnh thoại, hãy vuốt sang phải rồi vuốt lên, hoặc dùng thao tác bạn đã gán cho lệnh thoại. Hãy nói \"%1$s\" hoặc \"nói gì\" bất cứ lúc nào để xem lại danh sách này. Không cần nói đúng từng chữ: nói gần đúng, hoặc nói không dấu, Meridian vẫn hiểu.</string>
  <string name="voice_commands_help_hint">Mỗi trang sau liệt kê một nhóm lệnh kèm cách nói mẫu. Bạn cũng có thể tự đổi cách nói của từng lệnh trong Cài đặt, ở trang Lệnh thoại.</string>
  <string name="voice_command_screen_locked_hint">Bạn không thể dùng các lệnh thoại khi màn hình bị khóa. Để dùng trình đơn Meridian, hãy <xliff:g id="gesture" example="Swipe right then up">%1$s</xliff:g>.</string>
  <string name="voice_commands_during_setup_hint">Lệnh thoại không có sẵn trong khi thiết lập.</string>
