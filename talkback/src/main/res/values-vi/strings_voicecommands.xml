  <string name="voice_commands_help_verbosity">Độ chi tiết [thấp]</string>
  <string name="voice_commands_help_next_description">Chuyển đến tiêu đề, điều khiển, liên kết hoặc mốc tiếp theo</string>
  <string name="voice_commands_help_navigation_description">Di chuyển theo từ, ký tự, dòng, đoạn, tiêu đề, các thành phần điều khiển và nhiều tuỳ chọn khác</string>
  <string name="voice_commands_help_speech_rate_description">Cũng nói được \"nhanh hơn\", \"chậm hơn\", \"tăng tốc độ đọc\" hoặc \"giảm tốc độ đọc\"</string>
  <string name="voice_commands_help_verbosity_description">Thay đổi thành thấp, cao hoặc tuỳ chỉnh</string>
  <string name="voice_commands_help_first_description">Chuyển đến mục đầu tiên trên màn hình hiện tại</string>
  <string name="voice_commands_help_last_description">Chuyển đến mục cuối cùng trên màn hình hiện tại</string>
  <string name="voice_commands_help_languages_description">Thay đổi ngôn ngữ nói (chuyển văn bản sang lời nói)</string>
  <string name="voice_commands_help_find_items_title">Tìm mục</string>
  <string name="voice_commands_help_find_items_description">Tìm nội dung cụ thể trên màn hình hiện tại</string>
  <string name="voice_commands_help_find_text">Tìm [lưu]</string>
  <string name="voice_commands_help_find_text_description">Tìm mục đầu tiên chứa chữ \"lưu\" trên màn hình hiện tại</string>
  <string name="voice_commands_help_find_description">Nói lại \"tìm\" một mình để chuyển đến mục tiếp theo chứa chữ đó</string>
  <string name="voice_commands_help_screen_search_description">Nhập một cụm từ tìm kiếm để tìm văn bản đó trên màn hình</string>
  <string name="voice_commands_help_text_editing_description">Nhập, chọn và sao chép văn bản</string>
  <string name="voice_commands_help_type_text">Nhập [văn bản]</string>
  <string name="voice_commands_help_copy_description">Chọn văn bản trước khi sao chép</string>
  <string name="voice_commands_help_cut_description">Chọn văn bản trước khi cắt</string>
  <string name="voice_commands_help_delete_description">Chọn văn bản trước khi xóa. Meridian sẽ hỏi lại; trả lời \"đúng\" hoặc \"có\" mới xóa</string>
  <string name="voice_commands_help_device_navigation_title">Di chuyển trên thiết bị</string>
  <string name="voice_commands_help_device_navigation_description">Chuyển đến Màn hình chính, quay lại, hiển thị thông báo và các lệnh khác</string>
  <string name="voice_commands_help_overview_description">Xem các ứng dụng gần đây</string>
  <string name="voice_commands_help_assistant_description">Mở Trợ lý Google</string>
  <string name="voice_commands_help_other_commands_title">Các lệnh khác</string>
  <string name="voice_commands_help_other_commands_description">Chuyển đến phần cài đặt của Meridian, ẩn màn hình, xem các thao tác, thêm nhãn tuỳ chỉnh và các lệnh khác</string>
  <string name="voice_commands_help_label">Gắn nhãn [gửi]</string>
  <string name="voice_commands_help_hide_screen_description">Ẩn màn hình để người khác không thấy được màn hình của bạn ở nơi công cộng</string>
  <string name="voice_commands_help_show_screen_description">Sau khi ẩn, hãy đưa màn hình về trạng thái bình thường</string>
  <string name="voice_commands_help_actions_description">Hiển thị các thao tác hiện có đối với mục hiện tại</string>
  <string name="voice_commands_help_label_description">Thêm hoặc chỉnh sửa nhãn tùy chỉnh để nói \"gửi\"</string>
  <string name="voice_commands_help_stop_description">Dừng đọc ngay lập tức</string>
  <string name="voice_commands_help_type_text_description">Nói \"gõ\", \"nhập\", \"viết\" hoặc \"đánh vần\", rồi đọc văn bản muốn nhập</string>
  <string name="voice_commands_help_item_number">Đi tới mục số [5]</string>
  <string name="voice_commands_help_item_number_description">Chuyển thẳng tới mục thứ mấy trên màn hình, đếm theo thứ tự đọc</string>
  <string name="voice_commands_help_numbers_title">Âm lượng, tốc độ và báo thức</string>
  <string name="voice_commands_help_volume">Âm lượng [50 phần trăm]</string>
  <string name="voice_commands_help_volume_description">Đặt âm lượng giọng đọc. Kênh nhạc và phim: \"âm lượng nhạc 30 phần trăm\", cũng gọi là \"âm lượng phương tiện\"</string>
  <string name="voice_commands_help_volume_step">Tăng âm lượng</string>
  <string name="voice_commands_help_volume_step_description">Tăng hoặc giảm 10 điểm. Nói kèm con số để đổi nhiều hơn: \"tăng âm lượng 20\", \"giảm tốc độ đọc 10\"</string>
  <string name="voice_commands_help_alarm">Báo thức [5 phút]</string>
  <string name="voice_commands_help_alarm_description">Đặt báo thức đếm ngược: \"báo thức 1 giờ 30 phút\", \"đếm ngược 45 giây\"</string>
  <string name="voice_commands_help_alarm_clock">Báo thức lúc [7 giờ 30 tối]</string>
  <string name="voice_commands_help_alarm_clock_description">Đặt báo thức tới một giờ cụ thể. Nếu giờ đó đã qua hôm nay, báo thức hẹn sang ngày mai</string>
  <string name="voice_commands_help_repeat">[Cuộn xuống] 3 lần</string>
  <string name="voice_commands_help_repeat_description">Lặp lại một thao tác, tối đa 20 lần</string>
  <string name="voice_commands_help_word_numbers">Nói số bằng chữ</string>
  <string name="voice_commands_help_word_numbers_description">Mọi con số trong các lệnh trên đều nói bằng chữ được: \"âm lượng năm mươi phần trăm\", \"báo thức năm phút\", \"đi tới mục số ba\"</string>
  <string name="voice_commands_help_your_way_title">Ra lệnh theo cách của bạn</string>
  <string name="voice_commands_help_open_app">Mở [Facebook]</string>
  <string name="voice_commands_help_open_app_description">Nói tên bất kỳ thao tác nào gán được cho cử chỉ hoặc phím tắt để chạy thao tác đó. Nói \"mở\" và tên ứng dụng để mở ứng dụng</string>
  <string name="voice_commands_help_chain">Nhiều lệnh trong một câu</string>
  <string name="voice_commands_help_chain_description">Nối các lệnh bằng \"rồi\" hoặc \"sau đó\". Phần nào không hiểu được sẽ bỏ qua, các phần còn lại vẫn chạy</string>
  <string name="voice_commands_help_continuous">Nghe liên tục</string>
  <string name="voice_commands_help_continuous_description">Ra lệnh liên tiếp mà không cần mở lại lệnh thoại. Nói \"dừng\" hoặc \"xong\" để thoát. Cũng bật sẵn được trong Cài đặt, ở trang Lệnh thoại</string>
  <string name="voice_commands_help_teach">Tạo lệnh mới</string>
  <string name="voice_commands_help_teach_description">Dạy Meridian cụm từ của riêng bạn: nói \"tạo lệnh mới\" rồi làm theo hướng dẫn, hoặc nói \"đặt lệnh\" và cụm từ, \"cho\", rồi tên thao tác. Một cụm từ có thể chạy nhiều thao tác liền nhau</string>
  <string name="voice_commands_help_ai">Dự phòng bằng AI</string>
  <string name="voice_commands_help_ai_description">Bật trong Cài đặt, ở trang Lệnh thoại: khi một câu không khớp lệnh nào, AI sẽ chọn thao tác gần nhất và chạy ngay</string>
  <string name="voice_commands_help_custom_words">Tự đổi cách nói</string>
  <string name="voice_commands_help_custom_words_description">Trong Cài đặt, ở trang Lệnh thoại, hai mục Từ khóa lệnh thoại và Câu lệnh cố định cho bạn sửa cách nói của từng lệnh theo ý mình</string>

