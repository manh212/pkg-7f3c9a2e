<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:key="@string/pref_category_group_voice_key">
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.VoiceEngineFragment"
        android:key="@string/pref_voice_engine_stream_screen_key"
        android:title="@string/title_pref_voice_engine_stream" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.VoiceProfilesFragment"
        android:key="@string/pref_voice_profiles_screen_key"
        android:persistent="false"
        android:title="@string/title_pref_voice_profiles" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.VoiceLanguageFragment"
        android:key="@string/pref_voice_language_screen_key"
        android:title="@string/title_pref_voice_language" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.VoicePronunciationFragment"
        android:key="@string/pref_voice_pronunciation_screen_key"
        android:title="@string/title_pref_voice_pronunciation" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.speechdictionary.SpeechDictionaryFragment"
        android:key="pref_speech_dictionary_screen"
        android:persistent="false"
        android:title="@string/title_pref_speech_dictionary" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:key="pref_speech_adjustment_screen"
        android:persistent="false"
        android:title="@string/title_pref_speech_adjustment" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.VoiceFeatureVoicesFragment"
        android:key="@string/pref_voice_feature_voices_screen_key"
        android:title="@string/title_pref_voice_feature_voices" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
