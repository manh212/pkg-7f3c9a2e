<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:title="@string/notification_filter_title">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_notification_numbers_alike"
        android:summary="@string/notification_numbers_alike_summary"
        android:title="@string/notification_numbers_alike_title" />
    <ListPreference
        android:defaultValue="0"
        android:key="pref_notification_cooldown"
        android:summary="%s"
        android:title="@string/notification_cooldown_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_notification_skip_prefix"
        android:summary="@string/notification_skip_prefix_summary"
        android:title="@string/notification_skip_prefix_title" />
    <ListPreference
        android:defaultValue="60"
        android:dependency="pref_notification_skip_prefix"
        android:key="pref_notification_prefix_memory"
        android:summary="%s"
        android:title="@string/notification_prefix_memory_title" />
    <ListPreference
        android:defaultValue="0"
        android:key="pref_notification_repeat_seconds"
        android:summary="%s"
        android:title="@string/notification_repeat_seconds_title" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:title="@string/notification_kinds_title">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="true"
        android:key="pref_notification_skip_media"
        android:title="@string/notification_skip_media_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_notification_skip_ongoing"
        android:summary="@string/notification_skip_ongoing_summary"
        android:title="@string/notification_skip_ongoing_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_notification_skip_foreground"
        android:summary="@string/notification_skip_foreground_summary"
        android:title="@string/notification_skip_foreground_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_notification_skip_progress"
        android:title="@string/notification_skip_progress_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_notification_skip_group_summaries"
        android:summary="@string/notification_skip_group_summaries_summary"
        android:title="@string/notification_skip_group_summaries_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_notification_skip_low_priority"
        android:title="@string/notification_skip_low_priority_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="pref_notification_skip_system"
        android:title="@string/notification_skip_system_title" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:title="@string/notification_category_reread">
    <ListPreference
        android:defaultValue="0"
        android:key="pref_notification_repeat_minutes"
        android:summary="%s"
        android:title="@string/notification_repeat_minutes_title" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
