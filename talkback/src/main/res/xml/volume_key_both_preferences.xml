<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <com.google.android.accessibility.talkback.preference.base.GestureListPreference
      android:defaultValue="@string/shortcut_value_toggle_touch_exploration"
      android:key="pref_volume_both_action"
      android:summary="%s"
      android:title="@string/volume_both_action_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="pref_notification_volume_keys_stop"
      android:title="@string/notification_volume_keys_title" />
</PreferenceScreen>
