<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_vibration_default"
      android:key="@string/pref_vibration_key"
      android:title="@string/title_pref_vibration" />
  <com.google.android.accessibility.talkback.preference.base.PercentSeekBarPreference
