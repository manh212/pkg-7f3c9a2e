<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <ListPreference
      android:key="@string/pref_verbosity_preset_key"
      android:title="@string/title_pref_reading_style"
      android:summary="%s"
      android:defaultValue="@string/pref_verbosity_preset_value_default"
      android:entries="@array/pref_verbosity_preset_entries"
      android:entryValues="@array/pref_verbosity_preset_values" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
      android:defaultValue="@string/pref_time_feedback_format_default"
      android:dialogTitle="@string/pref_time_feedback_format_title"
      android:entries="@array/pref_time_feedback_format_entries"
      android:entryValues="@array/pref_time_feedback_format_values"
      android:key="@string/pref_time_feedback_format_key"
      android:summary="%s"
      android:title="@string/pref_time_feedback_format_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:title="@string/title_pref_always_interrupt_speech"
      android:summary="@string/summary_pref_always_interrupt_speech"
      android:key="pref_always_interrupt_speech" />
</PreferenceScreen>
