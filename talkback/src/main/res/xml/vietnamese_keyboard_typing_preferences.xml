<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="@string/pref_vietnamese_keyboard_quick_telex_key"
      android:title="@string/vietnamese_ime_quick_telex" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="@string/pref_vietnamese_keyboard_show_language_key"
      android:title="@string/vietnamese_ime_show_language" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="@string/pref_vietnamese_keyboard_show_picker_key"
      android:title="@string/vietnamese_ime_show_picker" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.vietnameseime.VietnameseKeyboardShortcutsFragment"
      android:key="pref_vietnamese_keyboard_shortcuts_screen"
      android:title="@string/vietnamese_ime_shortcuts" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="@string/pref_vietnamese_keyboard_auto_capitalize_key"
      android:title="@string/vietnamese_ime_auto_capitalize" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="@string/pref_vietnamese_keyboard_double_space_period_key"
      android:title="@string/vietnamese_ime_double_space_period" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="@string/pref_vietnamese_keyboard_mic_enabled_key"
      android:title="@string/vietnamese_ime_mic_enabled" />
</PreferenceScreen>
