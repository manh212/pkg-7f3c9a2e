<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="@string/pref_vietnamese_keyboard_quick_telex_key"
      android:title="@string/vietnamese_ime_quick_telex" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="@string/pref_vietnamese_keyboard_show_language_key"
      android:title="@string/vietnamese_ime_show_language" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="@string/pref_vietnamese_keyboard_auto_capitalize_key"
      android:title="@string/vietnamese_ime_auto_capitalize" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="@string/pref_vietnamese_keyboard_double_space_period_key"
      android:title="@string/vietnamese_ime_double_space_period" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="@string/pref_vietnamese_keyboard_mic_enabled_key"
      android:title="@string/vietnamese_ime_mic_enabled" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="@string/pref_vietnamese_keyboard_t9_double_tap_key"
      android:title="@string/vietnamese_ime_t9_double_tap" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="@string/pref_vietnamese_keyboard_auto_switch_letters_on_space_key"
      android:title="@string/vietnamese_ime_auto_switch_letters_on_space" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="@string/pref_vietnamese_keyboard_word_suggestions_key"
      android:title="@string/vietnamese_ime_word_suggestions" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="@string/pref_vietnamese_keyboard_spell_check_key"
      android:title="@string/vietnamese_ime_spell_check" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:dependency="@string/pref_vietnamese_keyboard_spell_check_key"
      android:key="@string/pref_vietnamese_keyboard_ai_spell_model_key"
      android:summary="@string/vietnamese_ime_ai_spell_model_summary_not_downloaded"
      android:title="@string/vietnamese_ime_ai_spell_model" />
</PreferenceScreen>
