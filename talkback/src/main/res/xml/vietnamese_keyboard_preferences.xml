<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="pref_vietnamese_keyboard_android_settings"
      android:title="@string/vietnamese_ime_android_settings">
    <intent android:action="android.settings.INPUT_METHOD_SETTINGS" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreference>
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_vietnamese_keyboard_own_voice_default"
      android:key="@string/pref_vietnamese_keyboard_own_voice_key"
      android:title="@string/vietnamese_ime_own_voice" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
      android:defaultValue="@string/pref_vietnamese_keyboard_layout_default"
      android:dialogTitle="@string/vietnamese_ime_layout"
      android:entries="@array/pref_vietnamese_keyboard_layout_entries"
      android:entryValues="@array/pref_vietnamese_keyboard_layout_values"
      android:key="@string/pref_vietnamese_keyboard_layout_key"
      android:summary="%s"
      android:title="@string/vietnamese_ime_layout" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.vietnameseime.VietnameseKeyboardSizeFragment"
      android:key="pref_vietnamese_keyboard_size_screen"
      android:title="@string/vietnamese_ime_keyboard_size" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.vietnameseime.VietnameseKeyboardSoundFragment"
      android:key="pref_vietnamese_keyboard_sound_screen"
      android:title="@string/vietnamese_ime_sound_and_vibration" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.vietnameseime.VietnameseKeyboardTimingFragment"
      android:key="pref_vietnamese_keyboard_timing_screen"
      android:title="@string/vietnamese_ime_timing" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.vietnameseime.VietnameseKeyboardRowsFragment"
      android:key="pref_vietnamese_keyboard_rows_screen"
      android:title="@string/vietnamese_ime_keyboard_rows" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.vietnameseime.VietnameseKeyboardTypingFragment"
      android:key="pref_vietnamese_keyboard_typing_screen"
      android:title="@string/vietnamese_ime_typing" />
</PreferenceScreen>
