<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_vietnamese_keyboard_key_sound_category"
      android:title="@string/vietnamese_ime_sound_category">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="@string/pref_vietnamese_keyboard_key_sound_key"
        android:title="@string/vietnamese_ime_key_sound" />
    <Preference
        android:dependency="@string/pref_vietnamese_keyboard_key_sound_key"
        android:key="@string/pref_vietnamese_keyboard_key_sound_space_key"
        android:persistent="false"
        android:title="@string/vietnamese_ime_key_sound_space" />
    <Preference
        android:dependency="@string/pref_vietnamese_keyboard_key_sound_key"
        android:key="@string/pref_vietnamese_keyboard_key_sound_normal_key"
        android:persistent="false"
        android:title="@string/vietnamese_ime_key_sound_normal" />
    <Preference
        android:dependency="@string/pref_vietnamese_keyboard_key_sound_key"
        android:key="@string/pref_vietnamese_keyboard_key_sound_delete_key"
        android:persistent="false"
        android:title="@string/vietnamese_ime_key_sound_delete" />
    <Preference
        android:dependency="@string/pref_vietnamese_keyboard_key_sound_key"
        android:key="@string/pref_vietnamese_keyboard_key_sound_enter_key"
        android:persistent="false"
        android:title="@string/vietnamese_ime_key_sound_enter" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory
      android:key="pref_vietnamese_keyboard_vibration_category"
      android:title="@string/vietnamese_ime_vibration_category">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
        android:defaultValue="false"
        android:key="@string/pref_vietnamese_keyboard_vibrate_on_key_key"
        android:title="@string/vietnamese_ime_vibrate_on_key" />
    <com.google.android.accessibility.talkback.preference.base.PercentSeekBarPreference
        android:defaultValue="100"
        android:dependency="@string/pref_vietnamese_keyboard_vibrate_on_key_key"
        android:key="@string/pref_vietnamese_keyboard_vibration_level_key"
        android:max="100"
        android:title="@string/vietnamese_ime_vibration_level"
        app:min="0"
        app:seekBarIncrement="5"
        app:showSeekBarValue="true" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
