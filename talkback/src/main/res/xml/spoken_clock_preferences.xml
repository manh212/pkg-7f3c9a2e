<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:key="pref_notification_clock_enabled"
      android:title="@string/timer_clock_enabled_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="pref_notification_clock_hours_screen"
      android:persistent="false"
      android:title="@string/timer_clock_hours_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
      android:key="pref_notification_clock_interval"
      android:defaultValue="60"
      android:title="@string/notification_clock_interval_title"
      android:dialogTitle="@string/notification_clock_interval_title"
      android:entries="@array/timer_interval_entries"
      android:entryValues="@array/timer_interval_values"
      android:summary="%s" />
  <EditTextPreference
      android:dialogMessage="@string/notification_clock_format_message"
      android:key="pref_notification_clock_format"
      android:title="@string/notification_clock_format_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="pref_notification_clock_sound"
      android:title="@string/timer_clock_sound_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:key="pref_timer_sound_choice"
      android:persistent="false"
      android:title="@string/timer_sound_choice_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="pref_notification_clock_vibration"
      android:title="@string/timer_clock_vibration_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:title="@string/timer_speech_category">
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:key="pref_timer_voice_profile"
        android:defaultValue=""
        android:title="@string/timer_voice_title"
        android:dialogTitle="@string/timer_voice_title" />
    <com.google.android.accessibility.material.preference.AccessibilitySuiteListPreference
        android:key="pref_timer_audio_stream"
        android:defaultValue="accessibility"
        android:title="@string/timer_stream_title"
        android:dialogTitle="@string/timer_stream_title"
        android:entries="@array/timer_stream_entries"
        android:entryValues="@array/timer_stream_values"
        android:summary="%s" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
