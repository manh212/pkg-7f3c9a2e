<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_soundback_default"
      android:key="@string/pref_soundback_key"
      android:title="@string/title_pref_soundback" />
  <com.google.android.accessibility.talkback.preference.base.PercentSeekBarPreference
      android:dependency="@string/pref_soundback_key"
      android:key="@string/pref_soundback_volume_seekbar_key_int"
      android:persistent="false"
      android:title="@string/title_pref_soundback_volume" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="pref_mute_screen_reader_sounds_in_silent"
      android:title="@string/silent_sounds_title"
      android:summary="@string/silent_sounds_summary" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_mute_speech_while_recording_default"
      android:key="@string/pref_mute_speech_while_recording_key"
      android:title="@string/title_pref_mute_speech_while_recording"
      android:summary="@string/summary_pref_mute_speech_while_recording" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="@bool/pref_speak_volume_changes_default"
      android:key="@string/pref_speak_volume_changes_key"
      android:summary="@string/summary_pref_speak_volume_changes"
      android:title="@string/title_pref_speak_volume_changes" />
</PreferenceScreen>
