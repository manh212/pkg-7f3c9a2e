<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.timer.SpokenClockSettingsFragment"
      android:key="@string/pref_sound_feature_clock_key"
      android:persistent="false"
      android:title="@string/spoken_clock_title" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
