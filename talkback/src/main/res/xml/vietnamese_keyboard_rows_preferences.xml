<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="true"
      android:key="@string/pref_vietnamese_keyboard_show_number_row_key"
      android:title="@string/vietnamese_ime_show_number_row" />
  <com.google.android.accessibility.material.preference.AccessibilitySuiteSwitchPreference
      android:defaultValue="false"
      android:key="@string/pref_vietnamese_keyboard_show_symbols_row_key"
      android:title="@string/vietnamese_ime_show_symbols_row" />
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
      android:fragment="com.google.android.accessibility.talkback.vietnameseime.VietnameseKeyboardSymbolsFragment"
      android:key="pref_vietnamese_keyboard_symbols_screen"
      android:title="@string/vietnamese_ime_symbols_row_customize" />
</PreferenceScreen>
