<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory android:key="@string/pref_category_group_speech_key">
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.ReadingStyleFragment"
        android:key="pref_reading_style_screen"
        android:persistent="false"
        android:title="@string/title_pref_reading_style" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.ReadingItemInfoFragment"
        android:key="pref_reading_item_info_screen"
        android:persistent="false"
        android:title="@string/title_pref_spoken_item_information" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.ReadingTextFragment"
        android:key="pref_reading_text_screen"
        android:persistent="false"
        android:title="@string/title_pref_reading_text" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.ScreenAnnouncementsFragment"
        android:key="pref_screen_announcements"
        android:summary="@string/summary_pref_screen_announcements"
        android:title="@string/title_pref_screen_announcements" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.status.StatusReadoutFragment"
        android:key="@string/pref_status_readout_key"
        android:title="@string/title_pref_status_readout" />
    <com.google.android.accessibility.material.preference.AccessibilitySuitePreference
        android:fragment="com.google.android.accessibility.talkback.preference.base.NavigationFeedbackFragment"
        android:key="pref_navigation_feedback_screen"
        android:title="@string/title_pref_navigation_spoken_feedback" />
  </com.google.android.accessibility.material.preference.AccessibilitySuitePreferenceCategory>
</PreferenceScreen>
