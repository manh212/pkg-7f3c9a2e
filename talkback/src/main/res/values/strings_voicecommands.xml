  <string name="voice_commands_help_open_app_description">Say the name of any action that can be assigned to a gesture or a shortcut to run it. Say \"open\" and an app name to open that app</string>
  <string name="voice_commands_help_chain">Several commands in one sentence</string>
  <string name="voice_commands_help_chain_description">Join commands with \"then\". A part nothing understands is skipped; the rest still run</string>
  <string name="voice_commands_help_continuous">Continuous listening</string>
  <string name="voice_commands_help_continuous_description">Give commands one after another without opening voice commands again. Say \"stop\" or \"done\" to end it. It can also be turned on in Settings, on the Voice commands page</string>
  <string name="voice_commands_help_teach">Create a new command</string>
  <string name="voice_commands_help_teach_description">Teach Meridian a phrase of your own: say the create-a-command phrase and follow the prompts, or say the set phrase, your phrase, the separator, and the action name. One phrase can run several actions in a row</string>
  <string name="voice_commands_help_ai">AI fallback</string>
  <string name="voice_commands_help_ai_description">Turn it on in Settings, on the Voice commands page: when a sentence matches no command, the AI picks the closest action and runs it right away</string>
  <string name="voice_commands_help_custom_words">Change how commands are said</string>
  <string name="voice_commands_help_custom_words_description">In Settings, on the Voice commands page, the Voice command keywords and Fixed commands entries let you change how each command is said</string>

